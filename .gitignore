# Build artifacts
# `build*/` (not `build/`) so that any build-prefixed directory is
# ignored: build_tbb/, build_check/, build_release/, build_debug/, …
# The previous exact `build/` rule let build_tbb/ slip through and
# 1.9 MB of generated .so + .ninja_log got committed to main once.
build*/
out/
bin/
lib/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# CMake
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# IDEs
.vscode/
.idea/
*.swp
*.swo
.vs/

# OS
.DS_Store
Thumbs.db

# Generated docs
site/
